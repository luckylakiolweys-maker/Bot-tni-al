# ╔═══════════════════════════════════════════════════════════════╗
# ║                     TNI AL BOT CONFIGURATION                 ║
# ╚═══════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════
# DISCORD CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Discord Bot Token (dari Discord Developer Portal)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# Client ID (Bot ID)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Guild ID (Server ID)
GUILD_ID=1535621923097284658

# ═══════════════════════════════════════════════════════════════
# ROLE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Admin Role ID (untuk command: pengumuman, text, panel-ticket, blacklist-add, unblacklist)
ADMIN_ROLE_ID=1535622963867680879

# Secatam & Setam Role ID (untuk command: secatam, setam)
SECATAM_SETAM_ROLE_ID=1535697948619309178

# ═══════════════════════════════════════════════════════════════
# SETAM CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Role ID untuk ping di SETAM
SETAM_PING_ROLE=1535672559494758522

# Channel URL untuk stage SETAM
SETAM_STAGE=https://discord.com/channels/1535621923097284658/1535660118958546996

# ═══════════════════════════════════════════════════════════════
# SECATAM CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Role ID untuk ping di SECATAM
SECATAM_PING_ROLE=1535701934244110416

# Channel URL untuk stage SECATAM
SECATAM_STAGE=https://discord.com/channels/1535621923097284658/1535659847838597121

# ═══════════════════════════════════════════════════════════════
# GENERAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Roblox Link (untuk SETAM dan SECATAM)
ROBLOX_LINK=https://www.roblox.com/share?code=78c726003821064da9b3affa020eb0fa&type=ExperienceDetails&stamp=1786248097736

# Laporan Channel ID (channel untuk panel-ticket reports)
LAPORAN_CHANNEL_ID=YOUR_LAPORAN_CHANNEL_ID_HERE

# ═══════════════════════════════════════════════════════════════
# INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════

# 1. Dapatkan DISCORD_TOKEN:
#    - Buka https://discord.com/developers/applications
#    - Pilih bot Anda
#    - Tab "Bot" → Copy "TOKEN"

# 2. Dapatkan CLIENT_ID:
#    - Di Discord Developers Application page
#    - Tab "General Information" → Copy "APPLICATION ID"

# 3. Dapatkan GUILD_ID:
#    - Di Discord, enable Developer Mode (User Settings → Advanced → Developer Mode)
#    - Right-click server → Copy Server ID

# 4. Dapatkan ROLE_ID:
#    - Enable Developer Mode
#    - Right-click role → Copy Role ID

# 5. Dapatkan CHANNEL_ID:
#    - Enable Developer Mode
#    - Right-click channel → Copy Channel ID

# ═══════════════════════════════════════════════════════════════
# SETUP STEPS
# ═══════════════════════════════════════════════════════════════

# 1. Isi semua konfigurasi di atas dengan nilai yang sesuai
# 2. Pastikan bot memiliki permissions yang diperlukan
# 3. Jalankan: npm install
# 4. Jalankan: npm start

# ═══════════════════════════════════════════════════════════════
